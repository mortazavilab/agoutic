params {
    sample = 'JamshidApproved'
    //readType can either be 'RNA', 'DNA' or 'CDNA'
    readType = 'CDNA'
    // change this value if 0.9 is too strict
    // if set to null or '' then modkit will determine its threshold by sampling reads.
    modkitFilterThreshold = 0.9
    // No modifications for CDNA mode
    modifications = ''
    //change setting if necessary
    //filterbedTask defaults to a 3-read minimum
    minCov = 3
    perMod = 5
    // change if the launch directory is not where the pod5 and output directories should go
    topDir = "${launchDir}"

    scriptEnv = "${launchDir}/dogme.profile"

    // needs to be modified to match the right genomic reference
    genome_annot_refs = [
        [name: 'mm39', genome: '/Users/eli/code/agoutic/data/references/mm39/IGVFFI9282QLXO.fasta', annot: '/Users/eli/code/agoutic/data/references/mm39/IGVFFI4777RDZK.gtf']
    ]

    kallistoIndex = '/Users/eli/code/agoutic/data/references/mm39/mm39GencM36_k63.idx'
    t2g = '/Users/eli/code/agoutic/data/references/mm39/mm39GencM36_k63.t2g'

    //default accuracy is sup
    accuracy = "hac"
    // change this value if 0.9 is too strict
    // if set to null or '' then modkit will determine its threshold by sampling reads.
    modkitFilterThreshold = 0.9

    // these paths are all based on the topDir and sample name
    // dogme will populate all of these folders with its output
    modDir = "${params.topDir}/dorModels"
    dorDir = "${params.topDir}/dor12-${params.sample}"
    podDir = "${params.topDir}/pod5"
    bamDir = "${params.topDir}/bams"
    annotDir = "${params.topDir}/annot"
    bedDir = "${params.topDir}/bedMethyl"
    fastqDir = "${params.topDir}/fastqs"
    kallistoDir = "${params.topDir}/kallisto"
    tmpDir = '/tmp'  // Temporary directory for disk-based sorting
}

process {
    // <-- Container Settings --->
    container = 'ghcr.io/mortazavilab/dogme-pipeline:latest'
    containerOptions = "-v /home/seyedam:/home/seyedam -v /Users/eli/code/agoutic/data:/Users/eli/code/agoutic/data -v /Users/eli/code/agoutic:/Users/eli/code/agoutic "
    beforeScript = 'export PATH=/opt/conda/bin:$PATH'

    executor = 'local'

    // General default settings - adjust as necessary
    cpus = 1
    memory = '32 GB'
    time = '8:00:00'

    withName: 'extractfastqTask' {
        // Matches the script's thread count and gives safe memory buffer
        cpus = 6
        memory = '24 GB'
        time = '4 h'
    }

    withName: 'doradoTask' {
        memory = '32 GB'  // Increase if necessary
        cpus = 4         // dorado is more GPU intensive than CPU intensive
        time = '12:00:00'
        containerOptions = "--gpus all -v /home/seyedam:/home/seyedam -v /Users/eli/code/agoutic/data:/Users/eli/code/agoutic/data -v /Users/eli/code/agoutic:/Users/eli/code/agoutic "
    }
    
    withName: 'modkitTask' {
        memory = '64 GB'
        cpus = 8
    }
    
    withName: 'openChromatinTaskBg' {
        memory = '9 GB'  // Increase if necessary
        cpus = 4         // dorado is more GPU intensive than CPU intensive
        containerOptions = "--gpus all -v /home/seyedam:/home/seyedam -v /Users/eli/code/agoutic/data:/Users/eli/code/agoutic/data -v /Users/eli/code/agoutic:/Users/eli/code/agoutic "
    }

    withName: 'openChromatinTaskBed' {
        memory = '9 GB'  // Increase if necessary
        cpus = 4         // dorado is more GPU intensive than CPU intensive
        containerOptions = "--gpus all -v /home/seyedam:/home/seyedam -v /Users/eli/code/agoutic/data:/Users/eli/code/agoutic/data -v /Users/eli/code/agoutic:/Users/eli/code/agoutic "
    }

    withName: 'minimapTask' {
        cpus = 8
        memory = '64 GB'  // Increase memory for minimap2 remap/sort
    }
}

docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

timeline {
    enabled = true
    overwrite = true
    file = "${params.sample}_timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.sample}_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.sample}_trace.txt"
}